Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deny direct access to app and storage/private
  RewriteRule ^app/ - [F,L]
  RewriteRule ^storage/private/ - [F,L]

  # If a requested file exists under /public, serve it directly
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f
  RewriteRule ^(.*)$ public/$1 [L]

  # Otherwise, route everything to /public/index.php
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

<FilesMatch "\.(env|sql|ini|log)$">
  Require all denied
</FilesMatch>